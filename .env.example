# ---- Model (any OpenAI-compatible endpoint) ----
# Pick ONE block, paste your key. Tested models and results: see README.
#
# Anthropic (course default):
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_MODEL=claude-haiku-5-5
LLM_API_KEY=paste-your-key-here
LLM_REASONING_EFFORT=
#
# OpenAI:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-6-luna
#   LLM_REASONING_EFFORT=none     (gpt-6-luna only allows tools on this API with reasoning off)
#
# OpenRouter (one key, many models):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=anthropic/claude-haiku-5.5

# ---- Defenses (off = vulnerable) ----
DEFENSE_RECIPIENTS=off   # email only to the store domain or a customer address on file
DEFENSE_AUTHZ=off        # customers see only their own data; only staff refund, up to $150
DEFENSE_MCP_PIN=off      # drop MCP tools whose definition changed since approval
DEFENSE_MEMORY=off       # memory writes wait for review instead of becoming policy

# ---- Where "external" email is delivered (the attacker's listener on Kali) ----
EXTERNAL_MAIL_RELAY=http://host.docker.internal:9000
# Optional: send the agent's backend/MCP traffic through Burp on Kali
HTTP_PROXY_FOR_TOOLS=
